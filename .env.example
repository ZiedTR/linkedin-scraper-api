# --- Data provider selection ---
# rapidapi_generic = classic linkedin-data-api (rockapis-style) endpoints
# fresh            = Fresh LinkedIn Profile Data on RapidAPI (paid)
# pdl              = People Data Labs — FREE 100 lookups/month, reliable
LINKEDIN_PROVIDER=rapidapi_generic

# To use People Data Labs (recommended free option), set:
#   LINKEDIN_PROVIDER=pdl
#   LINKEDIN_PDL_API_KEY=your_pdl_key   (free at peopledatalabs.com, no card)

# --- Upstream credentials (set these in Render, NOT in git) ---
LINKEDIN_RAPIDAPI_KEY=your_rapidapi_key_here
LINKEDIN_RAPIDAPI_HOST=linkedin-data-api.p.rapidapi.com
LINKEDIN_BASE_URL=https://linkedin-data-api.p.rapidapi.com

# To use Fresh LinkedIn Profile Data instead, set:
#   LINKEDIN_PROVIDER=fresh
#   LINKEDIN_RAPIDAPI_HOST=fresh-linkedin-profile-data.p.rapidapi.com
#   LINKEDIN_BASE_URL=https://fresh-linkedin-profile-data.p.rapidapi.com
#   LINKEDIN_RAPIDAPI_KEY=your_rapidapi_key_here

# --- Tuning ---
LINKEDIN_CACHE_TTL=900
LINKEDIN_RATE_LIMIT=100/minute
